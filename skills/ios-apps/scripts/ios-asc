#!/usr/bin/env python3
"""ios-asc status <bundle-id> | draft <listing.json> | submit <bundle-id> [--show]

status  what the listing holds and what still blocks submission (read only)
draft   write the listing draft from a JSON file (see lib/ios_asc/draft.py)
submit  file the review submission as a red action: it asks the user to tap, then submits
"""
import json, os, pathlib, subprocess, sys, tempfile
sys.path.insert(0, str(pathlib.Path(os.environ.get("HERALD_HOME", pathlib.Path.home() / ".herald")) / "extensions/ios/lib"))
from ios_asc.client import Client
from ios_asc import draft, review

cmd, arg = sys.argv[1], sys.argv[2]
c = Client()
if cmd == "draft":
    print("\n".join(draft.apply(json.load(open(arg)), c)))
else:
    app = c.app(arg); v = c.editable_version(app["id"])
    if cmd == "status":
        lines, problems = review.readiness(c, app["id"], v["id"])
        print("\n".join(lines)); print("blocking: " + ("; ".join(problems) or "nothing"))
    elif cmd == "submit":
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
            json.dump({"app_id": app["id"], "version_id": v["id"]}, f)
        extra = sys.argv[3:]
        sys.exit(subprocess.call(["herald", "act", "run", "ios.submit-review", "--payload-file", f.name] + extra))
